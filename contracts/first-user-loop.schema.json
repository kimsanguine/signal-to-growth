{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimsanguine/signal-to-growth/contracts/first-user-loop.schema.json",
  "title": "First User Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segment",
    "evidence_basis",
    "evidence_ids",
    "channel",
    "offer",
    "value_moment",
    "capacity",
    "budget",
    "batch_size",
    "review_at",
    "stop_condition",
    "external_write",
    "metric_ids",
    "proposed_metrics",
    "decision_id"
  ],
  "properties": {
    "segment": {"type": "string", "minLength": 1},
    "evidence_basis": {
      "enum": ["prior_evidence", "first_experiment"]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV-[0-9]{8}-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "channel": {"type": "string", "minLength": 1},
    "offer": {"type": "string", "minLength": 1},
    "value_moment": {"type": "string", "minLength": 1},
    "capacity": {"type": "integer", "minimum": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": {"type": "string", "minLength": 3, "maxLength": 3},
        "amount": {"type": "number", "minimum": 0}
      }
    },
    "batch_size": {"type": "integer", "minimum": 1},
    "review_at": {"type": "string", "format": "date-time"},
    "stop_condition": {"type": "string", "minLength": 1},
    "external_write": {"const": false},
    "metric_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MET-[0-9]{8}-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "proposed_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "why_this_metric", "how_to_measure"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "why_this_metric": {"type": "string", "minLength": 1},
          "how_to_measure": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision_id": {
      "type": ["string", "null"],
      "pattern": "^DEC-[0-9]{8}-[0-9]{3,}$"
    },
    "loop_mode": {
      "enum": ["direct_seeding", "introduction_enabled"]
    },
    "introduction_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_event",
        "reuse_window",
        "referral_eligibility",
        "recipient_fit",
        "landing_handoff",
        "hold_conditions",
        "external_write"
      ],
      "properties": {
        "activation_event": {"type": "string", "minLength": 1},
        "reuse_window": {"type": "string", "minLength": 1},
        "referral_eligibility": {"type": "string", "minLength": 1},
        "recipient_fit": {"type": "string", "minLength": 1},
        "landing_handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audience", "trigger", "promise", "evidence_ids", "cta"],
          "properties": {
            "audience": {"type": "string", "minLength": 1},
            "trigger": {"type": "string", "minLength": 1},
            "promise": {"type": "string", "minLength": 1},
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EV-[0-9]{8}-[0-9]{3,}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "cta": {"type": "string", "minLength": 1}
          }
        },
        "hold_conditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "external_write": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"loop_mode": {"const": "introduction_enabled"}},
        "required": ["loop_mode"]
      },
      "then": {"required": ["introduction_loop"]}
    },
    {
      "if": {"required": ["introduction_loop"]},
      "then": {
        "properties": {"loop_mode": {"const": "introduction_enabled"}},
        "required": ["loop_mode"]
      }
    },
    {
      "$comment": "prior_evidence claims an existing record; first_experiment is the honest label when this batch is how evidence gets created, so evidence_ids may stay empty.",
      "if": {
        "properties": {"evidence_basis": {"const": "prior_evidence"}},
        "required": ["evidence_basis"]
      },
      "then": {
        "properties": {"evidence_ids": {"minItems": 1}}
      }
    },
    {
      "$comment": "A real metric_id or a self-proposed candidate must exist — this experiment is not exempt from stating what would count as a good result, only from requiring that result to already be a validated contract.",
      "anyOf": [
        {"properties": {"metric_ids": {"minItems": 1}}},
        {"properties": {"proposed_metrics": {"minItems": 1}}}
      ]
    }
  ]
}
