{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimsanguine/signal-to-growth/contracts/outcome.schema.json",
  "title": "Growth Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome_id",
    "action_id",
    "metric_id",
    "observed_at",
    "value",
    "sample_size",
    "maturity_status",
    "query_version",
    "comparison",
    "conclusion",
    "next_decision_id",
    "interpretation",
    "evidence_ids",
    "recorded_by"
  ],
  "properties": {
    "outcome_id": {
      "type": "string",
      "pattern": "^OUT-[0-9]{8}-[0-9]{3,}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^ACT-[0-9]{8}-[0-9]{3,}$"
    },
    "metric_id": {
      "type": "string",
      "pattern": "^MET-[0-9]{8}-[0-9]{3,}$"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "value": {
      "type": ["number", "string", "boolean", "object", "null"]
    },
    "sample_size": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "maturity_status": {
      "enum": ["not_mature", "mature", "unknown"]
    },
    "query_version": {"type": "string", "minLength": 1},
    "comparison": {
      "enum": ["better", "worse", "flat", "inconclusive", "unknown"]
    },
    "conclusion": {
      "enum": ["continue", "change", "stop", "hold", "unknown"]
    },
    "next_decision_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^DEC-[0-9]{8}-[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "interpretation": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV-[0-9]{8}-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "recorded_by": {"type": "string", "minLength": 1}
  }
}
