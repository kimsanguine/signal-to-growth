{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimsanguine/signal-to-growth/contracts/metric.schema.json",
  "title": "Growth Metric Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_id",
    "name",
    "purpose",
    "entity",
    "population",
    "numerator",
    "denominator",
    "window",
    "value_event",
    "data_source",
    "query_version",
    "timezone",
    "cohort_maturity_rule",
    "exclusions",
    "baseline",
    "target",
    "target_source",
    "owner",
    "counter_metric_ids"
  ],
  "properties": {
    "metric_id": {
      "type": "string",
      "pattern": "^MET-[0-9]{8}-[0-9]{3,}$"
    },
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "entity": {"type": "string", "minLength": 1},
    "population": {"type": "string", "minLength": 1},
    "numerator": {"type": "string", "minLength": 1},
    "denominator": {"type": "string", "minLength": 1},
    "window": {"type": "string", "minLength": 1},
    "value_event": {"type": "string", "minLength": 1},
    "data_source": {"type": "string", "minLength": 1},
    "query_version": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "cohort_maturity_rule": {"type": "string", "minLength": 1},
    "exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "baseline": {
      "oneOf": [
        {"$ref": "#/$defs/measurement"},
        {"type": "null"}
      ]
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/target"},
        {"type": "null"}
      ]
    },
    "target_source": {"type": ["string", "null"]},
    "owner": {"type": "string", "minLength": 1},
    "counter_metric_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "record_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prev_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "type": "object"
          }
        },
        "required": ["target"]
      },
      "then": {
        "properties": {
          "target_source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "observed_at", "source_ref", "cohort_mature"],
      "properties": {
        "value": {},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_ref": {"type": "string", "minLength": 1},
        "cohort_mature": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "review_at", "rationale"],
      "properties": {
        "value": {},
        "review_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
