{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimsanguine/signal-to-growth/contracts/reply-draft.schema.json",
  "title": "Korean CS Reply Draft",
  "description": "A draft artifact only. It cannot authorize or execute an external write.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_id",
    "source_event_ids",
    "conversation_ref",
    "provider",
    "product",
    "session_state",
    "content",
    "template_ref",
    "template_variables",
    "risk_class",
    "status",
    "approval_id",
    "expires_at",
    "external_write"
  ],
  "properties": {
    "draft_id": {
      "type": "string",
      "pattern": "^DRAFT-[A-Z0-9][A-Z0-9._-]{7,127}$"
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CSE-[A-Za-z0-9._-]{8,128}$"
      }
    },
    "conversation_ref": {
      "type": "string",
      "pattern": "^(ref|hmac):[A-Za-z0-9_-]{8,192}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "product": {
      "type": "string",
      "enum": [
        "consulttalk",
        "alimtalk",
        "brand_message",
        "naver_talktalk",
        "channel_talk",
        "happytalk",
        "web_chat",
        "other"
      ]
    },
    "session_state": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "closed",
        "unknown",
        "not_applicable"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "template_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^TPL-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "template_variables": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/templateVariable"
      }
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_human_review",
        "approved",
        "blocked",
        "expired"
      ],
      "default": "draft"
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APR-[A-Z0-9][A-Z0-9._-]{2,127}$",
      "default": null
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_write": {
      "description": "Draft generation never performs the send.",
      "const": false,
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "templateVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value_redacted",
        "sensitivity"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value_redacted": {
          "type": "string",
          "maxLength": 2000
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "safe",
            "redacted"
          ]
        }
      }
    }
  }
}
