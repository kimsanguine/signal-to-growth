{
  "version": "0.2.0",
  "evidence": {
    "minimum_distinct_participants": null,
    "require_source_locator": true,
    "require_human_strength_approval": true,
    "allow_synthetic_quotes": false
  },
  "privacy": {
    "default_classification": "internal",
    "require_consent_for_transcripts": true,
    "redact_before_public_output": true,
    "allowed_public_fixture_types": [
      "synthetic",
      "explicitly-licensed"
    ]
  },
  "actions": {
    "external_write_default": false,
    "require_human_approval_for": [
      "email",
      "direct_message",
      "publish",
      "reply",
      "send_message",
      "assign_conversation",
      "modify_template",
      "enable_fallback",
      "delete",
      "refund",
      "deploy"
    ]
  },
  "connectors": {
    "default_mode": "read_only",
    "default_mode_note": "Reserved, not enforced at runtime. This release has no outbound write path for a mode check to gate: BaseChannelAdapter.send_approved always raises and every adapter disables REPLY_SEND. Wire this field to an enforcement point before relying on it.",
    "outbound_default": false,
    "fallback_default": false,
    "require_secret_reference": true,
    "require_verified_event_before_normalization": true,
    "require_human_review_for_high_risk": true,
    "require_connection_approval_for": [
      "real_account_read",
      "webhook_change",
      "backfill",
      "credential_use",
      "retention_change"
    ],
    "blocked_verification_assurance": [
      "none"
    ]
  },
  "metrics": {
    "allow_unattributed_benchmarks": false,
    "require_baseline_or_unknown": true,
    "require_target_owner": true,
    "require_counter_metric": true
  }
}
