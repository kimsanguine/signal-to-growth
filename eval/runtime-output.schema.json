{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime", "mode", "results", "overall_verdict"],
  "properties": {
    "runtime": {"type": "string"},
    "mode": {"type": "string", "const": "fixture-only-read-only"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "selected_skill", "verdict", "hard_gate_pass", "external_write", "rationale", "next_action"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^C\\d{2}(?:-r[1-3])?$"},
          "selected_skill": {"type": "string"},
          "verdict": {"type": "string", "enum": ["pass", "fail", "blocked"]},
          "hard_gate_pass": {"type": "boolean"},
          "external_write": {"type": "boolean", "const": false},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 900},
          "next_action": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "overall_verdict": {"type": "string", "enum": ["pass", "fail", "blocked"]}
  }
}
